<h1>Clicker Game</h1>
<p>Clicks: <span id="click-count">0</span></p>
<button id="click-button">Click me!</button>
<!-- Add random Pokémon button -->
<button id="add-pokemon-button">Add Random Pokémon</button>

<!-- Logout button -->
<button id="logout-button">Logout</button>

<h2>Your Owned Pokémon</h2>
<ul id="pokemon-list"></ul>

<!-- Pagination Controls -->
<div id="pagination-controls" style="margin-top: 10px;">
  <button id="prev-page">Previous</button>
  <span id="page-info" style="margin: 0 8px;"></span>
  <button id="next-page">Next</button>
</div>

<script>
  function getToken() {
    return localStorage.getItem('token');
  }

  let currentPage = 1;
  const limit = 5;

  async function fetchOwnedPokemons(page = 1, limit = 5) {
    const token = getToken();
    if (!token) {
      document.getElementById('pokemon-list').innerText = 'You must be logged in to see your Pokémon.';
      return;
    }

    try {
      const res = await fetch('/users/me', {
        headers: {
          'Authorization': 'Bearer ' + token
        }
      });

      if (!res.ok) throw new Error('Failed to fetch Pokémon');

      const user = await res.json();
      const pokemons = user.ownedPokemons || [];

      const listEl = document.getElementById('pokemon-list');
      listEl.innerHTML = '';

      const start = (page - 1) * limit;
      const paginated = pokemons.slice(start, start + limit);

      if (paginated.length === 0 && page > 1) {
        currentPage--;
        fetchOwnedPokemons(currentPage, limit);
        return;
      }

      paginated.forEach(pokemon => {
        const li = document.createElement('li');
        li.style.marginBottom = '12px';

        li.innerHTML = `
          <strong>${pokemon.name}</strong> <br>
          Multiplier: ${pokemon.multiplier ?? 'N/A'} <br>
          <img src="${pokemon.image || pokemon.img || ''}" alt="${pokemon.name}" style="width: 80px; height: 80px; object-fit: contain; margin-top: 5px;">
        `;
        listEl.appendChild(li);
      });

      const totalPages = Math.ceil(pokemons.length / limit);
      document.getElementById('page-info').innerText = `Page ${page} of ${totalPages}`;
      document.getElementById('prev-page').disabled = page === 1;
      document.getElementById('next-page').disabled = page >= totalPages;

    } catch (error) {
      console.error(error);
      document.getElementById('pokemon-list').innerText = 'Error loading Pokémon.';
    }
  }

  fetchOwnedPokemons();

  document.getElementById('prev-page').addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      fetchOwnedPokemons(currentPage, limit);
    }
  });

  document.getElementById('next-page').addEventListener('click', () => {
    currentPage++;
    fetchOwnedPokemons(currentPage, limit);
  });

  // Clicker logic
  let count = 0;
  const button = document.getElementById('click-button');
  const display = document.getElementById('click-count');
  button.addEventListener('click', () => {
    count++;
    display.textContent = count;
  });

  // Add random Pokémon button logic
  document.getElementById('add-pokemon-button').addEventListener('click', async () => {
    const token = getToken();
    if (!token) {
      alert('You must be logged in to add a Pokémon');
      return;
    }

    try {
      const addRes = await fetch('/users/add-random-pokemon', {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token
        }
      });

      if (!addRes.ok) {
        const err = await addRes.json();
        alert('Error: ' + err.message);
        return;
      }

      const data = await addRes.json();
      alert(`Added Pokémon: ${data.pokemon.name}`);

      fetchOwnedPokemons(currentPage, limit);
    } catch (error) {
      console.error(error);
      alert('Failed to add random Pokémon.');
    }
  });

  // Logout button logic
  document.getElementById('logout-button').addEventListener('click', async () => {
    localStorage.removeItem('token');

    try {
      await fetch('/logout', { method: 'POST', credentials: 'include' });
    } catch (err) {
      console.error('Logout backend error:', err);
    }

    document.getElementById('pokemon-list').innerText = 'You must be logged in to see your Pokémon.';
    document.getElementById('page-info').innerText = '';
    alert('Logged out successfully');
  });
</script>
