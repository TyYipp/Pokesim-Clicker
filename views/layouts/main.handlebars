<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}}</title>
  <style>
    .favorite {
      color: red;
      font-weight: bold;
    }
    .not-favorite {
      color: gray;
    }
    /* Style for buttons */
    .button {
      padding: 6px 12px;
      background-color: #4CAF50;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      margin-right: 20px; /* Space between buttons */
      cursor: pointer;
      border: none;
      font-size: 1rem;
    }
    .button:hover {
      background-color: #45a049;
    }
    /* User greeting container */
    .user-info {
      display: inline-block;
      margin-left: 20px;
      font-weight: bold;
      vertical-align: middle;
    }
  </style>
</head>
<body>

  <!-- Universal buttons -->
  <a href="/" class="button">🏠 Home</a>
  <a href="/clicker" class="button">☝️ Clicker</a>
  <a onclick="goToAdmin()" class="button">Admin</a>

  <!-- User greeting without logout button -->
  {{#if user}}
    <span class="user-info">
      Hello, {{user.name}}!
    </span>
  {{/if}}

  <!-- Render dynamic content from specific views -->
  {{{body}}}

<script>
  async function goToAdmin() {
    try {
      const res = await fetch('/admin', {
        credentials: 'include'  // send cookies with the request
      });

      if (res.ok) {
        const html = await res.text();
        document.open();
        document.write(html);
        document.close();
      } else {
        const data = await res.json();
        alert(data.message || 'Access denied.');
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  async function logout() {
    try {
      const res = await fetch('/logout', {
        method: 'POST',
        credentials: 'include'
      });
      if (res.ok) {
        // Clear token from localStorage if you use it
        localStorage.removeItem('token');
        window.location.href = '/';  // reload to update UI
      } else {
        const data = await res.json();
        alert(data.message || 'Logout failed');
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }
</script>

</body>
</html>
