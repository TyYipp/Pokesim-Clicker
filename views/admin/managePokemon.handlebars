<h1>Manage Pokémon</h1>

<a href="/pokemon/add">Add New Pokémon</a>

<ul>
  {{#each pokemons}}
    <li>
      {{this.name}} - Multiplier: {{this.multiplier}}
      <br>
      <img src="{{this.image}}" alt="{{this.name}}" width="100">
      <form action="/pokemon/{{this._id}}/delete" method="POST" style="display:inline;">
        <button type="submit">Delete</button>
      </form>
      <a href="/pokemon/{{this._id}}/edit">Edit</a>
    </li>
  {{/each}}
</ul>

<a href="/admin">Back to Dashboard</a>
