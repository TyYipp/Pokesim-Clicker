<h1>Manage Users</h1>

<p>Number of users: {{users.length}}</p>

<ul>
  {{#each users}}
    <li>
      {{this.name}} ({{this.email}})

      <!-- Delete Button -->
      <form action="/admin/users/{{this._id}}/delete" method="POST" style="display:inline;">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
      </form>

      <!-- Update Button (Link to Edit Form) -->
      <a href="/admin/users/{{this._id}}/edit">Update</a>
    </li>
  {{/each}}
</ul>

<a href="/admin">Back to Dashboard</a>
